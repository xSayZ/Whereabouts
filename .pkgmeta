# Used by the BigWigs packager (CurseForge/GitHub release). The Makefile zip uses the same file list.
package-as: Whereabouts

externals:
  Libs/LibStub: https://repos.curseforge.com/wow/libstub/trunk
  Libs/CallbackHandler-1.0: https://repos.curseforge.com/wow/callbackhandler/trunk/CallbackHandler-1.0
  Libs/LibDataBroker-1.1: https://github.com/tekkub/libdatabroker-1-1
  Libs/LibDBIcon-1.0: https://repos.curseforge.com/wow/libdbicon-1-0/trunk/LibDBIcon-1.0

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

# Everything that is not part of the addon itself.
ignore:
  - tests
  - docs
  - scripts
  - Makefile
  - CLAUDE.md
  - CONTRIBUTING.md
  - SECURITY.md
  - .luacheckrc
  - .gitignore
  - .gitattributes
  - .github
  - dist
  - .release
